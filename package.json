{
  "name": "drawgraph",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "drawgraph",
  "icon": "media/icons/icon.png",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimuch/vscode-DrawGraph.git"
  },
  "bugs": {
    "url": "https://github.com/aimuch/vscode-DrawGraph/issues"
  },
  "homepage": "https://github.com/aimuch/vscode-DrawGraph#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "drawio",
    "draw.io",
    "diagrams.net",
    "mermaid",
    "plantuml",
    "uml",
    "diagram",
    "preview"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "drawGraph.drawio.url",
        "drawGraph.drawio.customLibraries",
        "drawGraph.plantuml.render",
        "drawGraph.plantuml.server",
        "drawGraph.plantuml.jar",
        "drawGraph.plantuml.java",
        "drawGraph.plantuml.dot",
        "drawGraph.exportOnSave",
        "drawGraph.exportOnSaveOutDir"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:mermaid",
    "onLanguage:plantuml",
    "onLanguage:markdown",
    "onView:drawGraph.diagramExplorer",
    "onWebviewPanel:drawGraph.preview",
    "onCommand:drawGraph.quickMenu",
    "onCommand:drawGraph.openSettings",
    "onCommand:drawGraph.extractSource",
    "onCommand:drawGraph.visualDiff",
    "onCommand:drawGraph.visualDiffFiles",
    "onCommand:drawGraph.generateClassDiagram",
    "onCommand:drawGraph.generateDependencyDiagram"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "drawGraph.diagramExplorer",
          "name": "%view.diagramExplorer%",
          "icon": "./media/icons/drawgraph.svg"
        }
      ]
    },
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration/mermaid.json"
      },
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "plantuml"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".pu",
          ".iuml",
          ".wsd"
        ],
        "configuration": "./language-configuration/plantuml.json"
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      },
      {
        "language": "plantuml",
        "scopeName": "source.plantuml",
        "path": "./syntaxes/plantuml.tmLanguage.json"
      },
      {
        "scopeName": "markdown.mermaid.codeblock",
        "path": "./syntaxes/mermaid.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.mermaid": "mermaid"
        }
      },
      {
        "scopeName": "markdown.plantuml.codeblock",
        "path": "./syntaxes/plantuml.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.plantuml": "plantuml"
        }
      }
    ],
    "snippets": [
      {
        "language": "mermaid",
        "path": "./snippets/mermaid.json"
      },
      {
        "language": "plantuml",
        "path": "./snippets/plantuml.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "drawGraph.drawio",
        "displayName": "%customEditor.drawio%",
        "selector": [
          {
            "filenamePattern": "*.drawio"
          },
          {
            "filenamePattern": "*.dio"
          },
          {
            "filenamePattern": "*.drawio.xml"
          },
          {
            "filenamePattern": "*.dio.xml"
          },
          {
            "filenamePattern": "*.drawio.svg"
          },
          {
            "filenamePattern": "*.dio.svg"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "drawGraph.drawioPng",
        "displayName": "%customEditor.drawio%",
        "selector": [
          {
            "filenamePattern": "*.drawio.png"
          },
          {
            "filenamePattern": "*.dio.png"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "drawGraph.quickMenu",
        "title": "%command.quickMenu%",
        "category": "DrawGraph",
        "icon": "./media/icons/drawgraph.svg"
      },
      {
        "command": "drawGraph.openSettings",
        "title": "%command.openSettings%",
        "category": "DrawGraph",
        "icon": "$(settings-gear)"
      },
      {
        "command": "drawGraph.preview.open",
        "title": "%command.preview.open%",
        "category": "DrawGraph",
        "icon": "$(open-preview)"
      },
      {
        "command": "drawGraph.preview.openToSide",
        "title": "%command.preview.openToSide%",
        "category": "DrawGraph",
        "icon": "$(open-preview)"
      },
      {
        "command": "drawGraph.preview.toggleLock",
        "title": "%command.preview.toggleLock%",
        "category": "DrawGraph",
        "icon": "$(pin)"
      },
      {
        "command": "drawGraph.preview.openAtLine",
        "title": "%command.preview.openToSide%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.plantuml.exportBlock",
        "title": "%command.drawio.exportSvg%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.drawio.new",
        "title": "%command.drawio.new%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.mermaid.new",
        "title": "%command.mermaid.new%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.plantuml.new",
        "title": "%command.plantuml.new%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.diagram.newFromTemplate",
        "title": "%command.diagram.newFromTemplate%",
        "category": "DrawGraph",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "drawGraph.mermaid.openInDrawio",
        "title": "%command.mermaid.openInDrawio%",
        "category": "DrawGraph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "drawGraph.drawio.exportSvg",
        "title": "%command.drawio.exportSvg%",
        "category": "DrawGraph",
        "icon": "$(export)"
      },
      {
        "command": "drawGraph.drawio.exportPng",
        "title": "%command.drawio.exportPng%",
        "category": "DrawGraph",
        "icon": "$(file-media)"
      },
      {
        "command": "drawGraph.drawio.copySvg",
        "title": "%command.drawio.copySvg%",
        "category": "DrawGraph",
        "icon": "$(copy)"
      },
      {
        "command": "drawGraph.drawio.copyPng",
        "title": "%command.drawio.copyPng%",
        "category": "DrawGraph",
        "icon": "$(clippy)"
      },
      {
        "command": "drawGraph.drawio.openAsText",
        "title": "%command.drawio.openAsText%",
        "category": "DrawGraph",
        "icon": "$(code)"
      },
      {
        "command": "drawGraph.plantuml.generateUrl",
        "title": "%command.plantuml.generateUrl%",
        "category": "DrawGraph",
        "icon": "$(link-external)"
      },
      {
        "command": "drawGraph.exportDocumentDiagrams",
        "title": "%command.exportDocumentDiagrams%",
        "category": "DrawGraph",
        "icon": "$(export)"
      },
      {
        "command": "drawGraph.extractSource",
        "title": "%command.extractSource%",
        "category": "DrawGraph",
        "icon": "$(file-code)"
      },
      {
        "command": "drawGraph.drawio.navigateCodeLinks",
        "title": "%command.drawio.navigateCodeLinks%",
        "category": "DrawGraph",
        "icon": "$(link)"
      },
      {
        "command": "drawGraph.drawio.insertCodeSymbol",
        "title": "%command.drawio.insertCodeSymbol%",
        "category": "DrawGraph",
        "icon": "$(symbol-class)"
      },
      {
        "command": "drawGraph.visualDiff",
        "title": "%command.visualDiff%",
        "category": "DrawGraph",
        "icon": "$(diff)"
      },
      {
        "command": "drawGraph.visualDiffFiles",
        "title": "%command.visualDiffFiles%",
        "category": "DrawGraph",
        "icon": "$(diff)"
      },
      {
        "command": "drawGraph.exportPdf",
        "title": "%command.exportPdf%",
        "category": "DrawGraph",
        "icon": "$(file-pdf)"
      },
      {
        "command": "drawGraph.drawio.exportPdf",
        "title": "%command.drawio.exportPdf%",
        "category": "DrawGraph",
        "icon": "$(file-pdf)"
      },
      {
        "command": "drawGraph.drawio.exportAllPages",
        "title": "%command.drawio.exportAllPages%",
        "category": "DrawGraph",
        "icon": "$(files)"
      },
      {
        "command": "drawGraph.convert.plantumlToMermaid",
        "title": "%command.convert.plantumlToMermaid%",
        "category": "DrawGraph",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "drawGraph.convert.mermaidToPlantuml",
        "title": "%command.convert.mermaidToPlantuml%",
        "category": "DrawGraph",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "drawGraph.markdown.exportFence",
        "title": "%command.markdown.exportFence%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.markdown.extractToDrawioSvg",
        "title": "%command.markdown.extractToDrawioSvg%",
        "category": "DrawGraph",
        "icon": "$(file-media)"
      },
      {
        "command": "drawGraph.generateClassDiagram",
        "title": "%command.generateClassDiagram%",
        "category": "DrawGraph",
        "icon": "$(symbol-class)"
      },
      {
        "command": "drawGraph.generateDependencyDiagram",
        "title": "%command.generateDependencyDiagram%",
        "category": "DrawGraph",
        "icon": "$(references)"
      },
      {
        "command": "drawGraph.drawio.downloadOfflinePack",
        "title": "%command.drawio.downloadOfflinePack%",
        "category": "DrawGraph",
        "icon": "$(cloud-download)"
      },
      {
        "command": "drawGraph.drawio.importOfflinePack",
        "title": "%command.drawio.importOfflinePack%",
        "category": "DrawGraph",
        "icon": "$(folder-opened)"
      },
      {
        "command": "drawGraph.drawio.removeOfflinePack",
        "title": "%command.drawio.removeOfflinePack%",
        "category": "DrawGraph",
        "icon": "$(trash)"
      },
      {
        "command": "drawGraph.diagramExplorer.refresh",
        "title": "%command.diagramExplorer.refresh%",
        "category": "DrawGraph",
        "icon": "$(refresh)"
      },
      {
        "command": "drawGraph.explorer.openEntry",
        "title": "%command.preview.open%",
        "category": "DrawGraph"
      },
      {
        "command": "drawGraph.openCodeTarget",
        "title": "%command.drawio.navigateCodeLinks%",
        "category": "DrawGraph"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "drawGraph.quickMenu",
          "when": "config.drawGraph.toolbar.showQuickMenu",
          "group": "navigation@10"
        },
        {
          "command": "drawGraph.preview.openToSide",
          "when": "editorLangId == mermaid || editorLangId == plantuml",
          "group": "navigation@11"
        },
        {
          "command": "drawGraph.mermaid.openInDrawio",
          "when": "editorLangId == mermaid",
          "group": "navigation@12"
        },
        {
          "command": "drawGraph.drawio.exportSvg",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "navigation@11"
        },
        {
          "command": "drawGraph.drawio.exportPng",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "navigation@12"
        },
        {
          "command": "drawGraph.drawio.copyPng",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "navigation@13"
        },
        {
          "command": "drawGraph.drawio.openAsText",
          "when": "activeCustomEditorId == drawGraph.drawio",
          "group": "navigation@14"
        },
        {
          "command": "drawGraph.openSettings",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng || activeWebviewPanelId == drawGraph.preview",
          "group": "navigation@15"
        },
        {
          "command": "drawGraph.drawio.copySvg",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "1_drawgraph@1"
        },
        {
          "command": "drawGraph.drawio.navigateCodeLinks",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "1_drawgraph@2"
        },
        {
          "command": "drawGraph.drawio.insertCodeSymbol",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "1_drawgraph@3"
        },
        {
          "command": "drawGraph.plantuml.generateUrl",
          "when": "editorLangId == plantuml",
          "group": "1_drawgraph@1"
        },
        {
          "command": "drawGraph.exportDocumentDiagrams",
          "when": "editorLangId == plantuml || editorLangId == markdown",
          "group": "1_drawgraph@2"
        },
        {
          "command": "drawGraph.drawio.exportPdf",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "1_drawgraph@4"
        },
        {
          "command": "drawGraph.drawio.exportAllPages",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng",
          "group": "1_drawgraph@5"
        },
        {
          "command": "drawGraph.visualDiff",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng || editorLangId == mermaid || editorLangId == plantuml",
          "group": "1_drawgraph@6"
        }
      ],
      "view/title": [
        {
          "command": "drawGraph.diagramExplorer.refresh",
          "when": "view == drawGraph.diagramExplorer",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "drawGraph.visualDiff",
          "when": "resourceFilename =~ /\\.(drawio|dio|mmd|mermaid|puml|plantuml|pu|iuml|wsd|svg|png)$/i",
          "group": "inline"
        },
        {
          "command": "drawGraph.visualDiff",
          "when": "resourceFilename =~ /\\.(drawio|dio|mmd|mermaid|puml|plantuml|pu|iuml|wsd|svg|png)$/i",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "drawGraph.preview.open",
          "when": "resourceLangId == mermaid || resourceLangId == plantuml",
          "group": "navigation"
        },
        {
          "command": "drawGraph.mermaid.openInDrawio",
          "when": "resourceLangId == mermaid",
          "group": "navigation"
        },
        {
          "command": "drawGraph.exportDocumentDiagrams",
          "when": "resourceLangId == plantuml || resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "drawGraph.extractSource",
          "when": "resourceExtname == .svg || resourceExtname == .png",
          "group": "navigation"
        },
        {
          "command": "drawGraph.visualDiff",
          "when": "resourceFilename =~ /\\.(drawio|dio|mmd|mermaid|puml|plantuml|pu|iuml|wsd)$/i",
          "group": "navigation"
        },
        {
          "command": "drawGraph.generateClassDiagram",
          "when": "explorerResourceIsFolder || resourceExtname == .ts || resourceExtname == .js || resourceExtname == .py || resourceExtname == .java || resourceExtname == .cs || resourceExtname == .go || resourceExtname == .rs || resourceExtname == .cpp",
          "group": "7_modification@1"
        },
        {
          "command": "drawGraph.generateDependencyDiagram",
          "when": "explorerResourceIsFolder || resourceExtname == .ts || resourceExtname == .js || resourceExtname == .py",
          "group": "7_modification@2"
        }
      ],
      "commandPalette": [
        {
          "command": "drawGraph.preview.open",
          "when": "editorLangId == mermaid || editorLangId == plantuml"
        },
        {
          "command": "drawGraph.preview.openToSide",
          "when": "editorLangId == mermaid || editorLangId == plantuml"
        },
        {
          "command": "drawGraph.preview.toggleLock",
          "when": "activeWebviewPanelId == drawGraph.preview"
        },
        {
          "command": "drawGraph.preview.openAtLine",
          "when": "false"
        },
        {
          "command": "drawGraph.plantuml.exportBlock",
          "when": "false"
        },
        {
          "command": "drawGraph.markdown.exportFence",
          "when": "false"
        },
        {
          "command": "drawGraph.explorer.openEntry",
          "when": "false"
        },
        {
          "command": "drawGraph.openCodeTarget",
          "when": "false"
        },
        {
          "command": "drawGraph.diagramExplorer.refresh",
          "when": "view == drawGraph.diagramExplorer"
        },
        {
          "command": "drawGraph.convert.plantumlToMermaid",
          "when": "editorLangId == plantuml"
        },
        {
          "command": "drawGraph.convert.mermaidToPlantuml",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "drawGraph.markdown.extractToDrawioSvg",
          "when": "editorLangId == markdown"
        },
        {
          "command": "drawGraph.drawio.exportPdf",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.drawio.exportAllPages",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.mermaid.openInDrawio",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "drawGraph.plantuml.generateUrl",
          "when": "editorLangId == plantuml"
        },
        {
          "command": "drawGraph.exportDocumentDiagrams",
          "when": "editorLangId == plantuml || editorLangId == markdown"
        },
        {
          "command": "drawGraph.drawio.exportSvg",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.drawio.exportPng",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.drawio.copySvg",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.drawio.copyPng",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.drawio.openAsText",
          "when": "activeCustomEditorId == drawGraph.drawio"
        },
        {
          "command": "drawGraph.drawio.navigateCodeLinks",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        },
        {
          "command": "drawGraph.drawio.insertCodeSymbol",
          "when": "activeCustomEditorId == drawGraph.drawio || activeCustomEditorId == drawGraph.drawioPng"
        }
      ]
    },
    "keybindings": [
      {
        "command": "drawGraph.preview.openToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == mermaid || editorLangId == plantuml"
      },
      {
        "command": "drawGraph.preview.openToSide",
        "key": "alt+d",
        "when": "editorLangId == mermaid || editorLangId == plantuml"
      },
      {
        "command": "drawGraph.preview.open",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == mermaid || editorLangId == plantuml"
      }
    ],
    "configuration": {
      "title": "DrawGraph",
      "properties": {
        "drawGraph.language": {
          "type": "string",
          "enum": [
            "Auto",
            "Simplified Chinese",
            "English"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zhCn%",
            "%config.language.en%"
          ],
          "default": "Auto",
          "markdownDescription": "%config.language%"
        },
        "drawGraph.drawio.url": {
          "type": "string",
          "default": "https://embed.diagrams.net/",
          "markdownDescription": "%config.drawio.url%"
        },
        "drawGraph.drawio.offlineMode": {
          "type": "string",
          "enum": [
            "auto",
            "online",
            "offline"
          ],
          "enumDescriptions": [
            "%config.drawio.offlineMode.auto%",
            "%config.drawio.offlineMode.online%",
            "%config.drawio.offlineMode.offline%"
          ],
          "default": "auto",
          "markdownDescription": "%config.drawio.offlineMode%"
        },
        "drawGraph.drawio.ui": {
          "type": "string",
          "enum": [
            "kennedy",
            "min",
            "atlas",
            "sketch",
            "simple"
          ],
          "default": "kennedy",
          "markdownDescription": "%config.drawio.ui%"
        },
        "drawGraph.drawio.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "markdownDescription": "%config.drawio.theme%"
        },
        "drawGraph.drawio.config": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.drawio.config%"
        },
        "drawGraph.drawio.customLibraries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.drawio.customLibraries%"
        },
        "drawGraph.drawio.svgColorScheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "%config.drawio.svgColorScheme.auto%",
            "%config.drawio.svgColorScheme.light%",
            "%config.drawio.svgColorScheme.dark%"
          ],
          "default": "auto",
          "markdownDescription": "%config.drawio.svgColorScheme%"
        },
        "drawGraph.drawio.hideGithubIcon": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.drawio.hideGithubIcon%"
        },
        "drawGraph.drawio.vscodeShortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.drawio.vscodeShortcuts%"
        },
        "drawGraph.mermaid.theme": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "dark",
            "forest",
            "neutral",
            "base"
          ],
          "default": "auto",
          "markdownDescription": "%config.mermaid.theme%"
        },
        "drawGraph.markdown.mermaid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.markdown.mermaid%"
        },
        "drawGraph.markdown.plantuml": {
          "type": "boolean",
          "default": true,
