{
  "fileTypes": [],
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#wavedrom-code-block" }
  ],
  "repository": {
    "wavedrom-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(wavedrom|bitfield)(?:\\s+.*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.wavedrom",
          "patterns": [{ "include": "source.json" }]
        }
      ]
    }
  },
  "scopeName": "markdown.wavedrom.codeblock"
}
