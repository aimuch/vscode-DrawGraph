{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Graphviz (DOT)",
  "scopeName": "source.dot",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#attributes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.dot", "match": "//.*$" },
        { "name": "comment.line.number-sign.dot", "match": "^\\s*#.*$" },
        { "name": "comment.block.dot", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dot",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.dot", "match": "\\\\." }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dot",
          "match": "\\b(?i:strict|digraph|graph|subgraph|node|edge)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.edge.dot", "match": "->|--" }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "support.type.property-name.dot",
          "match": "\\b(?:label|shape|style|color|fillcolor|fontcolor|rankdir|rank|dir|arrowhead|arrowtail|fontsize|fontname)\\b(?=\\s*=)"
        },
        {
          "name": "constant.other.color.dot",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        }
      ]
    }
  }
}
